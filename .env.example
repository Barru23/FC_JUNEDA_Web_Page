# ================================================
# CF Juneda - Environment Variables
# Copia aixo a .env.local i omple les claus.
# MAI committis .env.local al Git.
# ================================================

# STRIPE
# https://dashboard.stripe.com/apikeys
# Nomes cal la clau secreta: el pagament es una sessio de Stripe Checkout
# creada al servidor i el navegador nomes hi redirigeix.
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
# Signing secret de la destination del webhook (Developers -> Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# SUPABASE
# https://supabase.com -> Settings -> API
# Igual que amb Stripe: nomes la clau de servei. Cap component del navegador
# consulta Supabase directament, tot passa per les rutes d'/api.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY_HERE

# APPS SCRIPT (full de calcul + correus)
# Substitueix l'API de Google Sheets i Resend: veure apps-script/Codi.gs.
# La URL /exec del desplegament com a aplicacio web, i el mateix token que
# hagis posat a la variable TOKEN de dins de l'script.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Ha de ser diferent d'ADMIN_PASSWORD: protegeixen coses diferents.
APPS_SCRIPT_TOKEN=la_mateixa_contrasenya_que_a_Codi.gs

# Identificador del full de calcul, per al boto "Obrir Full de Calcul" d'/admin.
# El trobaras a la propia URL del full, entre /d/ i /edit:
#   docs.google.com/spreadsheets/d/[AIXO_ES_L_IDENTIFICADOR]/edit
# Si no la poses, el boto simplement no surt (val mes que un enllac trencat).
NEXT_PUBLIC_MASTER_SHEET_ID=

# ADMIN
# Obligatoria en produccio: sense ella el panell /admin respon 503.
ADMIN_PASSWORD=your_admin_password_here

# SITE
# Opcional a Vercel (cau a VERCEL_PROJECT_PRODUCTION_URL), pero posa-la quan
# tingueu domini propi perque Stripe hi retorni el comprador.
NEXT_PUBLIC_SITE_URL=https://fc-juneda-web-page.vercel.app
