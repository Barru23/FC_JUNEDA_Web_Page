# ================================================
# CF Juneda - Environment Variables
# Copy this to .env.local and fill in your keys.
# NEVER commit .env.local to Git.
# ================================================

# STRIPE
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# SUPABASE
# Get from: https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_KEY_HERE

# GOOGLE SHEETS API
# Get from: Google Cloud Console -> IAM -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=cf-juneda@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
GOOGLE_MASTER_SHEET_ID=YOUR_SHEET_ID_HERE

# RESEND (Email)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=re_YOUR_KEY_HERE
# Fins que no verifiqueu un domini propi (ex. cfjuneda.cat) a Resend, cal
# fer servir onboarding@resend.dev. Un @gmail.com aquí fa fallar l'enviament.
RESEND_FROM_EMAIL=CF Juneda <onboarding@resend.dev>

# ADMIN
ADMIN_PASSWORD=your_admin_password_here

# SITE
NEXT_PUBLIC_SITE_URL=https://cf-juneda.vercel.app
